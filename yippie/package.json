{
  "name": "yippie",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@yippie/web",
    "dev:app": "turbo run dev --filter=@yippie/app",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@yippie/web",
    "build:app": "turbo run build --filter=@yippie/app",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "sync:config": "node packages/config/sync.mjs",
    "check:config": "node packages/config/sync.mjs --check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
