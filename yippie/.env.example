# ──────────────────────────────────────────────
# YIPPIE — Root .env.example
# Copy to .env and fill in values.
# Each app also has its own .env.example for
# app-specific variables.
# ──────────────────────────────────────────────

# Database (used by apps/app, not apps/web)
DATABASE_URL=postgresql://user:password@localhost:5432/yippie

# Transactional email (Resend)
# Generate a new key at https://resend.com/api-keys
RESEND_API_KEY=re_...

# ──────────────────────────────────────────────
# Public URLs (NEXT_PUBLIC_ prefix = exposed to browser)
# ──────────────────────────────────────────────

# Marketing site
NEXT_PUBLIC_WEB_URL=https://getyippie.com

# Application — change per environment:
#   local:      http://localhost:3001
#   staging:    https://dev.getyippie.com
#   production: https://app.getyippie.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ──────────────────────────────────────────────
# Auth (apps/app only)
# ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Railway sets this automatically when you bind a custom domain
NEXTAUTH_URL=http://localhost:3001

# ──────────────────────────────────────────────
# Environment discriminator
# Values: development | staging | production
# ──────────────────────────────────────────────
APP_ENV=development
