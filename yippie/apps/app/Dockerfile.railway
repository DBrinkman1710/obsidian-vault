## Stage 1: build the Vite/React frontend
FROM node:20-slim AS frontend-builder
WORKDIR /frontend
# Pin pnpm to the project's version. Unpinned installs pull pnpm 10, which turns
# ignored dependency build scripts (esbuild's postinstall) into a hard
# ERR_PNPM_IGNORED_BUILDS failure and breaks every deploy.
RUN npm install -g pnpm@9.15.4
COPY frontend/package.json ./
RUN pnpm install
COPY frontend/ .
# Vite inlines import.meta.env.* at build time — Railway only exposes service
# variables to Dockerfile builds when declared as ARG. Without this the platform
# saas.js snippet is never injected and product analytics stays empty.
ARG VITE_YIPPIE_PLATFORM_TOKEN
ENV VITE_YIPPIE_PLATFORM_TOKEN=$VITE_YIPPIE_PLATFORM_TOKEN
RUN pnpm run build

## Stage 2: build Python packages (needs gcc for C extensions)
FROM python:3.12-slim AS python-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

## Stage 3: lean runtime image — no gcc, no build tools
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 nginx && rm -rf /var/lib/apt/lists/*

# Copy the pre-built venv (no gcc needed at runtime)
COPY --from=python-builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend/ .

# Smoke tests gate the image build on Railway — a broken import, unbuildable
# response_model, duplicate route, or unimportable deploy script fails the build
# here instead of crashlooping uvicorn after deploy. All checks are DB-free;
# the Postgres-backed suite (test_smoke_db.py) auto-skips without TEST_DATABASE_URL.
RUN python -m pytest -q

COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

EXPOSE 8080
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8001 --proxy-headers --forwarded-allow-ips 127.0.0.1 & nginx -g 'daemon off;'"]
