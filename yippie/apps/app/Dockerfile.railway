## Stage 1: build the Vite/React frontend
FROM node:20-slim AS frontend-builder
WORKDIR /frontend
COPY frontend/package.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

## Stage 2: Python backend + nginx serving both
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc nginx gettext-base && rm -rf /var/lib/apt/lists/*

# Python deps + backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
COPY config/tenant.yaml ./config/tenant.yaml

# Frontend static assets
COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html

# nginx config template — PORT is substituted at container start
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf.template
RUN rm -f /etc/nginx/sites-enabled/default

CMD ["sh", "-c", "envsubst '$PORT' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && uvicorn app.main:app --host 0.0.0.0 --port 8001 & nginx -g 'daemon off;'"]
