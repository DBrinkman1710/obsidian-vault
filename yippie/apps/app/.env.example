# apps/app — app.getyippie.com (prod) / dev.getyippie.com (staging)
# These supplement the root .env.example.

DATABASE_URL=postgresql://user:password@localhost:5432/yippie

# Generate a new key at https://resend.com/api-keys
RESEND_API_KEY=re_...

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Railway sets this when you bind a custom domain; set manually for local dev
NEXTAUTH_URL=http://localhost:3001

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=https://getyippie.com

# Values: development | staging | production
APP_ENV=development
