DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/yippie
SECRET_KEY=change-me-in-production
ANTHROPIC_API_KEY=sk-ant-...

# AI provider — switch by changing AI_PROVIDER (no code change needed)
# Option 1 (default): Anthropic API
#   AI_PROVIDER=anthropic
#   AI_MODEL=claude-haiku-4-5-20251001
# Option 2: DeepSeek API (~40% cheaper, stronger model)
#   AI_PROVIDER=deepseek-api
#   DEEPSEEK_API_KEY=sk-...
#   AI_MODEL=deepseek-chat
# Option 3: Self-hosted vLLM / Ollama on Digital Ocean
#   AI_PROVIDER=self-hosted
#   AI_BASE_URL=http://your-droplet:8000/v1
#   AI_MODEL=DeepSeek-R1-Distill-Qwen-32B
AI_PROVIDER=anthropic
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ENVIRONMENT=production
EVOLUTION_API_URL=https://your-evolution-instance.railway.app
EVOLUTION_API_TOKEN=change-me
