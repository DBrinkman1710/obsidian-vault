DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/yippie
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# ── AI provider ────────────────────────────────────────────────────────────────
# Default: Mistral (EU-hosted, GDPR-safe). Switch by changing AI_PROVIDER.
# Option 1 (default): Mistral API
#   AI_PROVIDER=mistral
#   AI_MODEL=mistral-small-latest
# Option 2: Anthropic Claude (fallback)
#   AI_PROVIDER=anthropic
#   AI_MODEL=claude-haiku-4-5-20251001
# Option 3: DeepSeek API (~40% cheaper)
#   AI_PROVIDER=deepseek-api
#   AI_MODEL=deepseek-chat
# Option 4: Self-hosted vLLM / Ollama
#   AI_PROVIDER=self-hosted
#   AI_BASE_URL=http://your-droplet:8000/v1
#   AI_MODEL=DeepSeek-R1-Distill-Qwen-32B
AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest
MISTRAL_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# Yip agent uses a separate provider config for best tool-calling performance.
AI_AGENT_PROVIDER=mistral
AI_AGENT_MODEL=mistral-large-latest

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=hello@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_...    # for open/click tracking webhooks (optional)

# ── Authentication ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Encryption key for OAuth linked-email tokens (Gmail, Outlook). Must be set if
# email linking is enabled — orphans stored tokens otherwise.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_TOKEN_ENCRYPTION_KEY=...

# ── WhatsApp (Evolution API) ───────────────────────────────────────────────────
EVOLUTION_API_URL=https://your-evolution-instance.railway.app
EVOLUTION_API_TOKEN=change-me

# ── Stripe (billing) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET_PLATFORM=whsec_...

# ── Google OAuth (Gmail linking) ──────────────────────────────────────────────
# Optional — UI hides the Gmail connect button if absent.
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...

# ── Microsoft OAuth (Outlook linking) ─────────────────────────────────────────
# Optional — UI hides the Outlook connect button if absent.
MS_OAUTH_CLIENT_ID=...
MS_OAUTH_CLIENT_SECRET=...

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional locally — falls back to in-memory. Required on multi-instance deploys
# for distributed scheduler locks and rate limiters.
REDIS_URL=redis://redis:6379/0

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Optional — graceful no-op if absent.
SENTRY_DSN=https://...@sentry.io/...

# ── First-tenant bootstrap (used once by seed.py) ────────────────────────────
TENANT_ID=00000000-0000-0000-0000-000000000001
TENANT_NAME=My Company
# ENABLED_MODULES=inbox,contacts,tickets,calendar,pipeline   # defaults to all
# BRANDING_PRIMARY_COLOR=#5BA4F5
# BRANDING_LOGO_URL=https://...

# ── Product Analytics (Yippie platform owner) ─────────────────────────────────
# Platform owner's tracking token — injects into all tenant frontends so feature
# usage fires into the owner's SaaS analytics page.
# Get from GET /api/v1/saas/token as superadmin. Set as VITE_YIPPIE_PLATFORM_TOKEN
# in Railway "Production" env for apps/app.
VITE_YIPPIE_PLATFORM_TOKEN=
