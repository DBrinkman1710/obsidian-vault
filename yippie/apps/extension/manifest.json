{
  "manifest_version": 3,
  "name": "Yippie Inbox Analyser",
  "version": "1.2.0",
  "description": "See how much time you spend on email triage in Gmail or Outlook, and what Yippie saves you.",
  "permissions": ["identity", "storage"],
  "oauth2": {
    "client_id": "667142505587-u1fpflvqm11vhfv5ckk6o7n4o5lk76qs.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.metadata"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yippie Inbox Analyser",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
