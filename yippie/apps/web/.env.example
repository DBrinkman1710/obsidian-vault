# apps/web — getyippie.com
# These supplement the root .env.example.

NEXT_PUBLIC_WEB_URL=https://getyippie.com
NEXT_PUBLIC_APP_URL=https://app.getyippie.com

# Google Analytics 4 measurement ID (Consent Mode v2). Defaults to G-QN742BWE1G.
NEXT_PUBLIC_GA_ID=G-QN742BWE1G

# No DATABASE_URL needed — web is a static/ISR marketing site

# Yippie sales tracking — embed sales.js on getyippie.com to see visitor
# behaviour in the owner's Sales Tracking module. Get this token from
# GET /api/v1/sales/token while logged in as the superadmin tenant.
NEXT_PUBLIC_YIPPIE_TRACKING_TOKEN=
